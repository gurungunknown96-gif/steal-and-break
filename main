task.spawn(function()
    while true do
        task.wait(0.15)
        if S.AutoFarm and not S.Paused then
            local r = root()
            if r then
                for _, obj in ipairs(WS:GetDescendants()) do
                    local ok = false
                    if obj:IsA("ProximityPrompt") then
                        local part = obj.Parent
                        if part and part:IsA("BasePart") and (part.Position - r.Position).Magnitude <= S.FarmRadius then
                            if fireproximityprompt then pcall(fireproximityprompt, obj) end
                            ok = true
                        end
                    end
                    if obj:IsA("ClickDetector") then
                        local part = obj.Parent
                        if part and part:IsA("BasePart") and (part.Position - r.Position).Magnitude <= S.FarmRadius then
                            if fireclickdetector then pcall(fireclickdetector, obj) end
                        end
                    end
                end
            end
        end
    end
end)

