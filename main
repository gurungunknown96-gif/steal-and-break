        end)
    end
end)

local espFolder = Instance.new("Folder")
espFolder.Name = "RivoESP"
espFolder.Parent = WS

local function clearESP()
    for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
    for _, v in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if v.Name == "RivoTracer" then v:Destroy() end
    end
end

local function makeLabel(part, text, color)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0,160,0,44)
    bb.StudsOffset = Vector3.new(0,4,0)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder
    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
    bg.BackgroundTransparency = 0.4
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,6)
    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1,0, S.ESPHealth and 0.65 or 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    local distStr = ""
    if S.ESPDistance then
        local r = root()
        if r then distStr = "  ["..math.floor((part.Position-r.Position).Magnitude).."m]" end
    end
    lbl.Text = text .. distStr
    if S.ESPHealth then
        local h2 = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
        if h2 then
            local bar = Instance.new("Frame", bg)
            bar.Size = UDim2.new(h2.Health/h2.MaxHealth, 0, 0.3, 0)
            bar.Position = UDim2.new(0,0,0.7,0)
            bar.BackgroundColor3 = Color3.fromRGB(50,220,50)
            Instance.new("UICorner", bar).CornerRadius = UDim.new(0,3)
        end
    end
end

local function makeTracer(part, color)
    local sg = Instance.new("ScreenGui")
    sg.Name = "RivoTracer"
    sg.ResetOnSpawn = false
    sg.Parent = game:GetService("CoreGui")
    local line = Instance.new("Frame", sg)
    line.BackgroundColor3 = color
    line.BorderSizePixel = 0
    task.spawn(function()
        while S.ESPTracers and part and part.Parent do
            local cam = WS.CurrentCamera
            local vp = cam.ViewportSize
            local oy = S.TracerOrigin == "Center" and vp.Y/2 or vp.Y
            local ox = vp.X/2
            local pos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen then
                local dx,dy = pos.X-ox, pos.Y-oy
                local len = math.sqrt(dx*dx+dy*dy)
                line.Position = UDim2.new(0,ox,0,oy)
                line.Size = UDim2.new(0,len,0,1)
                line.Rotation = math.deg(math.atan2(dy,dx))
                line.Visible = true
            else line.Visible = false end
            task.wait(0.05)
        end
        sg:Destroy()
    end)
end

task.spawn(function()
    while true do
        task.wait(2)
        clearESP()
        if S.ESPEgg then
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n = obj.Name:lower()
                    if n:find("egg") or n:find("ore") or n:find("crystal") or n:find("gem") or n:find("rock") then
                        makeLabel(obj, obj.Name, Color3.fromRGB(255,230,50))
                    end
                end
            end
        end
        if S.ESPAnimal then
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("Model") then
                    local n = obj.Name:lower()
                    if n:find("animal") or n:find("pet") or n:find("creature") then
                        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                        if p then
                            makeLabel(p, obj.Name, Color3.fromRGB(50,255,160))
                            if S.ESPTracers then makeTracer(p, Color3.fromRGB(50,255,160)) end
                        end
                    end
                end
            end
        end
        if S.ESPPlayer then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        makeLabel(hrp, plr.Name, Color3.fromRGB(255,70,70))
                        if S.ESPTracers then makeTracer(hrp, Color3.fromRGB(255,70,70)) end
                    end
                end
            end
        end
    end
end)

