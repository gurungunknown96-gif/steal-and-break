task.spawn(function()
    local angle = 0
    while true do
        task.wait(0.05)
        if S.OrbitEnabled and S.TargetPlayer ~= "" then
            local tp = Players:FindFirstChild(S.TargetPlayer)
            if tp and tp.Character then
                local tr = tp.Character:FindFirstChild("HumanoidRootPart")
                local r = root()
                if tr and r then
                    angle = angle + S.OrbitSpeed * 0.05
                    r.CFrame = CFrame.new(tr.Position + Vector3.new(math.cos(angle)*S.OrbitRadius, 0, math.sin(angle)*S.OrbitRadius), tr.Position)
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if S.LoopTP and S.LoopTPName ~= "" then
            local obj = WS:FindFirstChild(S.LoopTPName, true)
            if obj then
                local pos = obj:IsA("BasePart") and obj.Position
                    or (obj:IsA("Model") and obj.PrimaryPart and obj.PrimaryPart.Position)
                if pos then tpTo(pos) end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastFPSTime >= 1 then lastFPS=frameCount; frameCount=0; lastFPSTime=now end
end)
