    l.TextColor3 = Color3.fromRGB(180,210,255)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = k..": —"
    iLabels[k] = l
end
task.spawn(function()
    while true do
        task.wait(0.5)
        infoFrame.Visible = S.InfoPanel
        if S.InfoPanel then
            iLabels["FPS"].Text  = "FPS: "    ..(S.ShowFPS   and lastFPS or "—")
            iLabels["Ping"].Text = "Ping: "   ..(S.ShowPing  and pingVal.."ms" or "—")
            iLabels["Cash"].Text = "Cash: "   ..(S.ShowCash  and cash() or "—")
            iLabels["Clock"].Text= "Clock: "  ..(S.ShowClock and os.date("%H:%M:%S") or "—")
            iLabels["Players"].Text = "Players: "..#Players:GetPlayers()
        end
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F2 then
        S.Paused = not S.Paused
    end
    if input.KeyCode == Enum.KeyCode.F3 then
        S.FlyEnabled = not S.FlyEnabled
        local h = hum()
        if h and not S.FlyEnabled then h.PlatformStand = false end
    end
    if input.KeyCode == Enum.KeyCode.F4 then
        S.NoclipEnabled = not S.NoclipEnabled
    end
end)

