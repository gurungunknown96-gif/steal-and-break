kGetKey.MouseButton1Click:Connect(function()
    pcall(function()
        game:GetService("GuiService"):SetClipboard(DISCORD)
    end)
    kGetKey.Text = "✅  Copied! — " .. DISCORD
    task.delay(3, function()
        kGetKey.Text = "🔗  Get Key — Click to copy Discord"
    end)
end)

local function launchHub()
    keySG.Enabled = false
    unlocked = true

    local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

    local Window = WindUI:CreateWindow({
        Title = "Rivo Hub  •  discord.gg/ZN4jtyPNHG",
        Icon = "rbxassetid://1234567890",
        Author = "Rivo",
        Folder = "RivoHub",
        Size = UDim2.fromOffset(580,440),
        Theme = "Dark",
        Resizable = true,
    })

    local TFarm = Window:Tab({Title="Farm", Icon="pickaxe"})
    TFarm:Section({Title="Breaking & Digging", Opened=true})
    TFarm:Toggle({Title="Auto Break", Default=false, Callback=function(v) S.AutoBreak=v end})
    TFarm:Slider({Title="Break Delay", Value={Min=0.05,Max=1,Default=0.15}, Step=0.05, Callback=function(v) S.BreakDelay=v end})
    TFarm:Toggle({Title="Auto Dig", Default=false, Callback=function(v) S.AutoDig=v end})
    TFarm:Toggle({Title="Auto Farm (radius)", Default=false, Callback=function(v) S.AutoFarm=v end})
    TFarm:Slider({Title="Farm Radius", Value={Min=10,Max=300,Default=60}, Step=5, Callback=function(v) S.FarmRadius=v end})
    TFarm:Section({Title="Collecting & Selling", Opened=true})
    TFarm:Toggle({Title="Auto Collect", Default=false, Callback=function(v) S.AutoCollect=v end})
    TFarm:Slider({Title="Collect Delay", Value={Min=0.05,Max=1,Default=0.15}, Step=0.05, Callback=function(v) S.CollectDelay=v end})
    TFarm:Toggle({Title="Auto Sell", Default=false, Callback=function(v) S.AutoSell=v end})
    TFarm:Slider({Title="Sell Delay (sec)", Value={Min=1,Max=60,Default=5}, Step=1, Callback=function(v) S.SellDelay=v end})
    TFarm:Toggle({Title="Auto Click (mouse target)", Default=false, Callback=function(v) S.AutoClick=v end})
    TFarm:Slider({Title="Auto Click Delay", Value={Min=0.01,Max=1,Default=0.05}, Step=0.01, Callback=function(v) S.AutoClickDelay=v end})
    TFarm:Section({Title="Rebirth", Opened=true})
    TFarm:Toggle({Title="Auto Rebirth", Default=false, Callback=function(v) S.AutoRebirth=v end})
    TFarm:Input({Title="Rebirth Cash Threshold", Value="1000000", Type="number", Callback=function(v) S.RebirthThreshold=tonumber(v) or 1000000 end})

    local TTrain = Window:Tab({Title="Training", Icon="dumbbell"})
    TTrain:Toggle({Title="Auto Equip Best", Default=false, Callback=function(v) S.AutoEquip=v end})
    TTrain:Toggle({Title="Auto Treadmill", Default=false, Callback=function(v) S.AutoTreadmill=v end})
    TTrain:Section({Title="Auto Upgrade", Opened=true})
    TTrain:Toggle({Title="Auto Upgrade Pickaxe", Default=false, Callback=function(v) S.AutoUpgradePick=v end})
    TTrain:Toggle({Title="Auto Upgrade Trail", Default=false, Callback=function(v) S.AutoUpgradeTrail=v end})
    TTrain:Toggle({Title="Auto Upgrade Plot", Default=false, Callback=function(v) S.AutoUpgradePlot=v end})
    TTrain:Toggle({Title="Auto Upgrade Treadmill", Default=false, Callback=function(v) S.AutoUpgradeTread=v end})
    TTrain:Section({Title="Spending Limits", Opened=false})
    TTrain:Input({Title="Cash Reserve (keep above)", Value="0", Type="number", Callback=function(v) S.CashReserve=tonumber(v) or 0 end})
    TTrain:Input({Title="Max Price Per Purchase", Value="0", Type="number", Callback=function(v) S.MaxPrice=tonumber(v) or 0 end})
    TTrain:Input({Title="Session Budget (0=unlimited)", Value="0", Type="number", Callback=function(v) S.SessionBudget=tonumber(v) or 0 end})

    local TClaim = Window:Tab({Title="Claims", Icon="gift"})
    TClaim:Toggle({Title="Auto Hatch", Default=false, Callback=function(v) S.AutoHatch=v end})
    TClaim:Toggle({Title="Auto Claim", Default=false, Callback=function(v) S.AutoClaim=v end})
    TClaim:Toggle({Title="Auto Place Animals", Default=false, Callback=function(v) S.AutoPlace=v end})
    TClaim:Toggle({Title="Auto Store Pets", Default=false, Callback=function(v) S.AutoStore=v end})
    TClaim:Toggle({Title="Auto Buy Egg", Default=false, Callback=function(v) S.AutoBuyEgg=v end})
    TClaim:Input({Title="Egg Buy Limit (0=unlimited)", Value="10", Type="number", Callback=function(v) S.EggLimit=tonumber(v) or 10 end})
    TClaim:Toggle({Title="Auto Collect Chests & Rewards", Default=false, Callback=function(v) S.AutoCollectReward=v end})
    TClaim:Section({Title="Daily / Quest / Event", Opened=true})
    TClaim:Toggle({Title="Auto Daily", Default=false, Callback=function(v) S.AutoDaily=v end})
    TClaim:Toggle({Title="Auto Quest", Default=false, Callback=function(v) S.AutoQuest=v end})
    TClaim:Toggle({Title="Auto Event", Default=false, Callback=function(v) S.AutoEvent=v end})

    local TESP = Window:Tab({Title="ESP", Icon="eye"})
    TESP:Toggle({Title="Egg / Ore ESP", Default=false, Callback=function(v) S.ESPEgg=v end})
    TESP:Toggle({Title="Animal / Pet ESP", Default=false, Callback=function(v) S.ESPAnimal=v end})
    TESP:Toggle({Title="Player ESP", Default=false, Callback=function(v) S.ESPPlayer=v end})
    TESP:Toggle({Title="Show Distance", Default=false, Callback=function(v) S.ESPDistance=v end})
    TESP:Toggle({Title="Health Bars", Default=false, Callback=function(v) S.ESPHealth=v end})
    TESP:Toggle({Title="Tracers", Default=false, Callback=function(v) S.ESPTracers=v end})
    TESP:Dropdown({Title="Tracer Origin", Values={"Bottom","Center"}, Value="Bottom", Callback=function(v) S.TracerOrigin=v end})

    local TMove = Window:Tab({Title="Movement", Icon="activity"})
    TMove:Section({Title="Speed", Opened=true})
    TMove:Toggle({Title="Speed Hack", Default=false, Callback=function(v) S.SpeedEnabled=v end})
    TMove:Slider({Title="Walk Speed", Value={Min=16,Max=300,Default=16}, Step=1, Callback=function(v) S.WalkSpeed=v end})
    TMove:Toggle({Title="Auto Sprint", Default=false, Callback=function(v) S.AutoSprint=v end})
    TMove:Slider({Title="Sprint Speed", Value={Min=16,Max=100,Default=28}, Step=1, Callback=function(v) S.SprintSpeed=v end})
    TMove:Section({Title="Air", Opened=true})
    TMove:Toggle({Title="Fly  [F3 to toggle]", Default=false, Callback=function(v)
        S.FlyEnabled=v
        local h=hum(); if h and not v then h.PlatformStand=false end
    end})
    TMove:Slider({Title="Fly Speed", Value={Min=1,Max=100,Default=3}, Step=1, Callback=function(v) S.FlySpeed=v end})
    TMove:Toggle({Title="Infinite Jump", Default=false, Callback=function(v) S.InfiniteJump=v end})
    TMove:Toggle({Title="High Jump", Default=false, Callback=function(v) S.HighJump=v end})
    TMove:Slider({Title="Jump Power", Value={Min=50,Max=500,Default=120}, Step=10, Callback=function(v) S.JumpPower=v end})
    TMove:Section({Title="Physics", Opened=true})
    TMove:Toggle({Title="Low Gravity", Default=false, Callback=function(v) S.LowGravity=v end})
    TMove:Slider({Title="Gravity Value", Value={Min=5,Max=196,Default=50}, Step=5, Callback=function(v) S.GravityVal=v end})
    TMove:Toggle({Title="Noclip  [F4 to toggle]", Default=false, Callback=function(v) S.NoclipEnabled=v end})
    TMove:Toggle({Title="Anti Slip", Default=false, Callback=function(v) S.AntiSlip=v end})
    TMove:Toggle({Title="Anti Void", Default=false, Callback=function(v) S.AntiVoid=v end})
    TMove:Slider({Title="Void Y Threshold", Value={Min=-500,Max=0,Default=-100}, Step=10, Callback=function(v) S.AntiVoidY=v end})

    local TPlayers = Window:Tab({Title="Players", Icon="users"})
    local function playerNames()
        local t={}
        for _,p in ipairs(Players:GetPlayers()) do if p~=LP then table.insert(t,p.Name) end end
        return #t>0 and t or {"None"}
    end
    TPlayers:Dropdown({Title="Target Player", Values=playerNames(), Callback=function(v) S.TargetPlayer=v end})
    TPlayers:Button({Title="Teleport To Player", Callback=function()
        local tp=Players:FindFirstChild(S.TargetPlayer)
        if tp and tp.Character then
            local tr=tp.Character:FindFirstChild("HumanoidRootPart")
            if tr then tpTo(tr.Position) end
        end
    end})
    TPlayers:Button({Title="Bring Player To Me", Callback=function()
        local tp=Players:FindFirstChild(S.TargetPlayer)
        if tp and tp.Character then
            local tr=tp.Character:FindFirstChild("HumanoidRootPart")
            local r=root()
            if tr and r then tr.CFrame=r.CFrame+Vector3.new(3,0,0) end
        end
    end})
    TPlayers:Toggle({Title="Orbit Player", Default=false, Callback=function(v) S.OrbitEnabled=v end})
    TPlayers:Slider({Title="Orbit Radius", Value={Min=3,Max=50,Default=10}, Step=1, Callback=function(v) S.OrbitRadius=v end})
    TPlayers:Slider({Title="Orbit Speed", Value={Min=0.1,Max=5,Default=1}, Step=0.1, Callback=function(v) S.OrbitSpeed=v end})
    TPlayers:Button({Title="Fling Player", Callback=function()
        local tp=Players:FindFirstChild(S.TargetPlayer)
        if tp and tp.Character then
            local tr=tp.Character:FindFirstChild("HumanoidRootPart")
            local r=root()
            if tr and r then
                r.CFrame=tr.CFrame
                tr.Velocity=Vector3.new(math.random(-500,500),1000,math.random(-500,500))
            end
        end
    end})
    TPlayers:Button({Title="Print All Players", Callback=function()
        for _,p in ipairs(Players:GetPlayers()) do print(p.Name.." | "..p.UserId) end
    end})

    local TTP = Window:Tab({Title="Teleport", Icon="map-pin"})
    TTP:Input({Title="Object / Part Name", Value="", Callback=function(v) S.TPTarget=v end})
    TTP:Button({Title="Teleport To Object", Callback=function()
        if S.TPTarget~="" then
            local obj=WS:FindFirstChild(S.TPTarget,true)
            if obj then
                local pos=obj:IsA("BasePart") and obj.Position
                    or (obj:IsA("Model") and obj.PrimaryPart and obj.PrimaryPart.Position)
                if pos then tpTo(pos) end
            end
        end
    end})
    TTP:Button({Title="Teleport To Spawn", Callback=function()
        local sp=WS:FindFirstChildOfClass("SpawnLocation")
        if sp then tpTo(sp.Position) end
    end})
    TTP:Button({Title="Teleport To Origin (0,100,0)", Callback=function()
        local r=root(); if r then r.CFrame=CFrame.new(0,100,0) end
    end})
    TTP:Toggle({Title="Loop TP To Object", Default=false, Callback=function(v) S.LoopTP=v end})
    TTP:Input({Title="Loop TP Target Name", Value="", Callback=function(v) S.LoopTPName=v end})
    TTP:Button({Title="Click TP (click anywhere)", Callback=function()
        local conn
        conn = UIS.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                conn:Disconnect()
                local r=root()
                if Mouse.Hit and r then r.CFrame=CFrame.new(Mouse.Hit.Position+Vector3.new(0,5,0)) end
            end
        end)
        WindUI:Notify({Title="Click TP", Content="Click anywhere to teleport.", Duration=3})
    end})

    local TMisc = Window:Tab({Title="Misc", Icon="settings"})
    TMisc:Toggle({Title="Pause All  [F2]", Default=false, Callback=function(v) S.Paused=v end})
    TMisc:Toggle({Title="Anti-AFK", Default=true, Callback=function(v) S.AntiAFK=v end})
    TMisc:Toggle({Title="Fullbright", Default=false, Callback=function(v) S.Fullbright=v end})
    TMisc:Section({Title="Chat", Opened=true})
    TMisc:Toggle({Title="Chat Spammer", Default=false, Callback=function(v) S.ChatSpam=v end})
    TMisc:Input({Title="Chat Message", Value="discord.gg/ZN4jtyPNHG", Callback=function(v) S.ChatMsg=v end})
    TMisc:Slider({Title="Spam Delay (sec)", Value={Min=3,Max=60,Default=10}, Step=1, Callback=function(v) S.ChatDelay=v end})
    TMisc:Section({Title="Server", Opened=true})
    TMisc:Toggle({Title="Server Hop", Default=false, Callback=function(v) S.ServerHop=v end})
    TMisc:Slider({Title="Hop If Players ≤", Value={Min=1,Max=20,Default=5}, Step=1, Callback=function(v) S.ServerHopMin=v end})
    TMisc:Button({Title="Rejoin", Callback=function()
        pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId,LP) end)
    end})
    TMisc:Button({Title="Print Remotes to Console", Callback=function()
        for _,v in ipairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then print(v.ClassName.."  "..v:GetFullName()) end
        end
    end})
    TMisc:Button({Title="Reset Character", Callback=function()
        local h=hum(); if h then h.Health=0 end
    end})

    local TInfo = Window:Tab({Title="Info", Icon="bar-chart-2"})
    TInfo:Toggle({Title="Info Panel", Default=false, Callback=function(v) S.InfoPanel=v end})
    TInfo:Toggle({Title="Show FPS", Default=false, Callback=function(v) S.ShowFPS=v end})
    TInfo:Toggle({Title="Show Ping", Default=false, Callback=function(v) S.ShowPing=v end})
    TInfo:Toggle({Title="Show Cash", Default=false, Callback=function(v) S.ShowCash=v end})
    TInfo:Toggle({Title="Show Clock", Default=false, Callback=function(v) S.ShowClock=v end})
    TInfo:Button({Title="Print Server Info", Callback=function()
        print("JobId: "..game.JobId)
        print("PlaceId: "..game.PlaceId)
        print("Players: "..#Players:GetPlayers())
        print("Cash: "..cash())
        local r=root(); if r then print("Pos: "..tostring(r.Position)) end
    end})

    local minSG = Instance.new("ScreenGui")
    minSG.Name = "RivoMinimize"
    minSG.ResetOnSpawn = false
    minSG.Parent = game:GetService("CoreGui")
    local minBtn = Instance.new("TextButton", minSG)
    minBtn.Size = UDim2.new(0,56,0,56)
    minBtn.Position = UDim2.new(0.5,-28,0,10)
    minBtn.BackgroundColor3 = Color3.fromRGB(15,25,55)
    minBtn.Text = "R"
    minBtn.TextColor3 = Color3.fromRGB(255,255,255)
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 20
    minBtn.Visible = false
    Instance.new("UICorner", minBtn).CornerRadius = UDim.new(0,14)
    local mStroke = Instance.new("UIStroke", minBtn)
    mStroke.Color = Color3.fromRGB(60,130,255); mStroke.Thickness = 2

    local windSG = nil
    local minimized = false
    local function findWindSG()
        for _,g in ipairs(game:GetService("CoreGui"):GetChildren()) do
            if g:IsA("ScreenGui") and g.Name:lower():find("wind") then return g end
        end
    end
    local function minimize()
        if minimized then return end
        minimized = true
        windSG = windSG or findWindSG()
        if windSG then windSG.Enabled=false end
        minBtn.Visible = true
    end
    local function restore()
        if not minimized then return end
        minimized = false
        windSG = windSG or findWindSG()
        if windSG then windSG.Enabled=true end
        minBtn.Visible = false
    end
    minBtn.MouseButton1Click:Connect(restore)
    task.spawn(function()
        task.wait(1.5)
        windSG = findWindSG()
        if windSG then
            for _,d in ipairs(windSG:GetDescendants()) do
                if d:IsA("TextButton") and (d.Text=="—" or d.Text=="-" or d.Text=="✕" or d.Text=="X") then
                    d.MouseButton1Click:Connect(function() task.wait(0.05); minimize() end)
                end
            end
        end
    end)
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightBracket then
            if minimized then restore() else minimize() end
        end
    end)

    WindUI:Notify({
        Title = "Rivo Hub Unlocked",
        Content = "F2=pause | F3=fly | F4=noclip | ]=minimize\ndiscord.gg/ZN4jtyPNHG",
        Duration = 8
    })
end

kBtn.MouseButton1Click:Connect(function()
    local entered = kInput.Text:gsub("%s","")
    if entered == VALID_KEY then
        kStatus.TextColor3 = Color3.fromRGB(50,220,50)
        kStatus.Text = "✅  Key accepted! Loading..."
        task.wait(0.8)
        launchHub()
    else
        kStatus.TextColor3 = Color3.fromRGB(255,80,80)
        kStatus.Text = "❌  Invalid key. Get it on our Discord."
        TS:Create(keyBox, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 4, true), {Position=keyBox.Position+UDim2.new(0,6,0,0)}):Play()
    end
end)

kInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then kBtn.MouseButton1Click:Fire() end
end)
