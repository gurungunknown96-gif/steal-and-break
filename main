local sessionSpent = 0
local lastFPS, frameCount, lastFPSTime = 0, 0, tick()
local pingVal = 0
local unlocked = false

local function root() local c=LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function hum()  local c=LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function cash()
    for _,f in ipairs({LP:FindFirstChild("leaderstats"),LP:FindFirstChild("Stats"),LP:FindFirstChild("Data")}) do
        if f then for _,v in ipairs(f:GetChildren()) do
            local n=v.Name:lower()
            if n:find("cash") or n:find("coin") or n:find("money") or n:find("gem") then return tonumber(v.Value) or 0 end
        end end
    end
    return 0
end
local function fireRemote(name)
    local r = RS:FindFirstChild(name, true)
    if r then
        if r:IsA("RemoteEvent") then pcall(function() r:FireServer() end) end
        if r:IsA("RemoteFunction") then pcall(function() r:InvokeServer() end) end
    end
end
local function tryPP(obj)
    if not obj then return end
    local pp = obj:FindFirstChildOfClass("ProximityPrompt")
    if pp and fireproximityprompt then pcall(fireproximityprompt, pp) end
    local cd = obj:FindFirstChild("ClickDetector") or (obj:IsA("ClickDetector") and obj)
    if cd and fireclickdetector then pcall(fireclickdetector, cd) end
end
local function tpTo(pos, off)
    local r = root()
    if r and pos then r.CFrame = CFrame.new(pos + (off or Vector3.new(0,4,0))) end
end
local function budgetOK(price)
    if S.CashReserve > 0 and cash() - price < S.CashReserve then return false end
    if S.MaxPrice > 0 and price > S.MaxPrice then return false end
    if S.SessionBudget > 0 and sessionSpent + price > S.SessionBudget then return false end
    return true
end

local function findAndFire(keywords)
    for _, obj in ipairs(WS:GetDescendants()) do
        local n = obj.Name:lower()
        for _, kw in ipairs(keywords) do
            if n:find(kw) then tryPP(obj) break end
        end
    end
end

local function getAllRemotes()
    local out = {}
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            table.insert(out, v)
        end
    end
    return out
end

local function spamRemote(names)
    for _, name in ipairs(names) do fireRemote(name) end
end

task.spawn(function()
    while true do
        task.wait(S.BreakDelay)
        if S.AutoBreak and not S.Paused then
            for _, obj in ipairs(WS:GetDescendants()) do
                if not S.AutoBreak or S.Paused then break end
                local n = obj.Name:lower()
                if n:find("egg") or n:find("ore") or n:find("rock") or n:find("crystal") or n:find("gem") or n:find("mine") or n:find("node") then
                    local pos
                    if obj:IsA("BasePart") then pos = obj.Position
                    elseif obj:IsA("Model") and obj.PrimaryPart then pos = obj.PrimaryPart.Position end
                    if pos then
                        tpTo(pos, Vector3.new(0,3,2))
                        tryPP(obj)
                        for _, d in ipairs(obj:GetDescendants()) do tryPP(d) end
                    end
                end
                task.wait(0.03)
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(S.CollectDelay)
        if S.AutoCollect and not S.Paused then
            for _, obj in ipairs(WS:GetDescendants()) do
                if not S.AutoCollect or S.Paused then break end
                local n = obj.Name:lower()
                if n:find("drop") or n:find("animal") or n:find("pet") or n:find("bag") or n:find("collect") or n:find("pickup") or n:find("item") then
                    local pos
                    if obj:IsA("BasePart") then pos = obj.Position
                    elseif obj:IsA("Model") and obj.PrimaryPart then pos = obj.PrimaryPart.Position end
                    if pos then
                        tpTo(pos, Vector3.new(0,2,0))
                        tryPP(obj)
                        for _, d in ipairs(obj:GetDescendants()) do tryPP(d) end
                    end
                end
                task.wait(0.03)
            end
        end
    end
end)

