local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
local Players    = game:GetService("Players")
local WS         = game:GetService("Workspace")
local RS         = game:GetService("ReplicatedStorage")
local UIS        = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LP         = Players.LocalPlayer

-- ─── STATE ────────────────────────────────────────────
local S = {
    -- Farm
    AutoBreak = false, AutoCollect = false, AutoSell = false,
    BreakDelay = 0.2, CollectDelay = 0.2, SellDelay = 5,
    AutoDig = false, AutoFarm = false, FarmRadius = 60,
    AutoRebirth = false, RebirthThreshold = 1000000,
    -- Claims
    AutoHatch = false, AutoClaim = false, AutoPlace = false,
    AutoStore = false, AutoBuyEgg = false, EggLimit = 10,
    AutoDaily = false, AutoQuest = false, AutoEvent = false,
    AutoCollectReward = false,
    -- Movement
    SpeedEnabled = false, WalkSpeed = 16,
    FlyEnabled = false, FlySpeed = 3,
    NoclipEnabled = false,
    InfiniteJump = false,
    HighJump = false, JumpPower = 100,
    AntiVoid = false, AntiVoidY = -100,
    LowGravity = false, GravityVal = 50,
    AutoSprint = false, SprintSpeed = 28,
    AntiSlip = false,
    -- ESP
    ESPEgg = false, ESPAnimal = false, ESPPlayer = false,
    ESPDistance = false, ESPHealth = false, ESPTracers = false,
    TracerOrigin = "Bottom",
    -- Players
    TargetPlayer = "",
    OrbitEnabled = false, OrbitRadius = 10, OrbitSpeed = 1,
    -- Misc
    AntiAFK = true, Paused = false,
    Fullbright = false,
    ChatSpam = false, ChatMsg = "discord.gg/ZN4jtyPNHG", ChatDelay = 10,
    ServerHop = false, ServerHopMin = 5,
    AutoClick = false, AutoClickDelay = 0.05,
    -- Info
    InfoPanel = false, ShowFPS = false, ShowPing = false,
    ShowCash = false, ShowClock = false,
}

local sessionBought = 0
local lastFPS, frameCount, lastFPSTime = 0, 0, tick()
local pingVal = 0

-- ─── HELPERS ──────────────────────────────────────────
local function root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function hum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function cash()
    for _, f in ipairs({ LP:FindFirstChild("leaderstats"), LP:FindFirstChild("Stats"), LP:FindFirstChild("Data") }) do
        if f then
            for _, v in ipairs(f:GetChildren()) do
                local n = v.Name:lower()
                if n:find("cash") or n:find("coin") or n:find("money") or n:find("gem") then
                    return tonumber(v.Value) or 0
                end
            end
        end
    end
    return 0
end
local function fireRemote(name, ...)
    local r = RS:FindFirstChild(name, true)
    if r then
        if r:IsA("RemoteEvent") then pcall(function() r:FireServer(...) end) end
        if r:IsA("RemoteFunction") then pcall(function() r:InvokeServer(...) end) end
    end
end
local function tryProximity(obj)
    local pp = obj:FindFirstChildOfClass("ProximityPrompt")
    if pp and fireproximityprompt then pcall(fireproximityprompt, pp) end
    local cd = obj:FindFirstChild("ClickDetector")
    if cd and fireclickdetector then pcall(fireclickdetector, cd) end
end
local function tpTo(pos, offset)
    local r = root()
    offset = offset or Vector3.new(0, 4, 0)
    if r and pos then r.CFrame = CFrame.new(pos + offset) end
end

-- ─── FARM LOOPS ───────────────────────────────────────

-- Auto Break
task.spawn(function()
    while true do
        task.wait(S.BreakDelay)
        if S.AutoBreak and not S.Paused then
            for _, obj in ipairs(WS:GetDescendants()) do
                if not S.AutoBreak or S.Paused then break end
                local n = obj.Name:lower()
                if n:find("egg") or n:find("ore") or n:find("rock") or n:find("crystal") or n:find("gem") or n:find("mine") then
                    local pos
                    if obj:IsA("BasePart") then pos = obj.Position
                    elseif obj:IsA("Model") and obj.PrimaryPart then pos = obj.PrimaryPart.Position end
                    if pos then
                        tpTo(pos, Vector3.new(0, 3, 3))
                        tryProximity(obj)
                    end
                end
                task.wait(0.05)
            end
        end
    end
end)

-- Auto Collect
task.spawn(function()
    while true do
        task.wait(S.CollectDelay)
        if S.AutoCollect and not S.Paused then
            for _, obj in ipairs(WS:GetDescendants()) do
                if not S.AutoCollect or S.Paused then break end
                local n = obj.Name:lower()
                if n:find("drop") or n:find("animal") or n:find("pet") or n:find("bag") or n:find("collect") then
                    local pos
                    if obj:IsA("BasePart") then pos = obj.Position
                    elseif obj:IsA("Model") and obj.PrimaryPart then pos = obj.PrimaryPart.Position end
                    if pos then
                        tpTo(pos, Vector3.new(0, 3, 0))
                        tryProximity(obj)
                    end
                end
                task.wait(0.05)
            end
        end
    end
end)

-- Auto Sell
task.spawn(function()
    while true do
        task.wait(S.SellDelay)
        if S.AutoSell and not S.Paused then
            fireRemote("Sell")
            fireRemote("SellAll")
            fireRemote("SellItems")
            for _, obj in ipairs(WS:GetDescendants()) do
                local n = obj.Name:lower()
                if n:find("sell") then tryProximity(obj) end
            end
        end
    end
end)

-- Auto Dig
task.spawn(function()
    while true do
        task.wait(0.3)
        if S.AutoDig and not S.Paused then
            for _, obj in ipairs(WS:GetDescendants()) do
                local n = obj.Name:lower()
                if n:find("dig") or n:find("drill") or n:find("mine") then tryProximity(obj) end
            end
        end
    end
end)

-- Auto Farm (radius proximity spam)
task.spawn(function()
    while true do
        task.wait(0.2)
        if S.AutoFarm and not S.Paused then
            local r = root()
            if r then
                for _, obj in ipairs(WS:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                        local part = obj.Parent
                        if part and part:IsA("BasePart") then
                            if (part.Position - r.Position).Magnitude <= S.FarmRadius then
                                if obj:IsA("ProximityPrompt") and fireproximityprompt then pcall(fireproximityprompt, obj) end
                                if obj:IsA("ClickDetector") and fireclickdetector then pcall(fireclickdetector, obj) end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Auto Rebirth
task.spawn(function()
    while true do
        task.wait(5)
        if S.AutoRebirth and cash() >= S.RebirthThreshold then
            fireRemote("Rebirth")
            fireRemote("DoRebirth")
            fireRemote("PlayerRebirth")
        end
    end
end)

-- Auto Click
task.spawn(function()
    while true do
        task.wait(S.AutoClickDelay)
        if S.AutoClick then
            pcall(function()
                local mouse = LP:GetMouse()
                local target = mouse.Target
                if target then
                    tryProximity(target)
                    if target.Parent then tryProximity(target.Parent) end
                end
            end)
        end
    end
end)

-- ─── CLAIMS LOOPS ─────────────────────────────────────

task.spawn(function()
    while true do
        task.wait(2)
        if S.AutoHatch then
            fireRemote("HatchEgg") fireRemote("Hatch")
            for _, obj in ipairs(WS:GetDescendants()) do
                local n = obj.Name:lower()
                if n:find("hatch") or n:find("incubat") then tryProximity(obj) end
            end
        end
        if S.AutoClaim then
            fireRemote("ClaimIndex") fireRemote("Claim") fireRemote("ClaimReward")
        end
        if S.AutoPlace then
            fireRemote("PlaceAnimal") fireRemote("PlacePet")
        end
        if S.AutoStore then
            fireRemote("StorePet") fireRemote("StoreAnimal")
        end
    end
end)

task.spawn(function()
    local bought = 0
    while true do
        task.wait(2)
        if S.AutoBuyEgg and (S.EggLimit == 0 or bought < S.EggLimit) then
            fireRemote("BuyEgg") fireRemote("PurchaseEgg")
            bought = bought + 1
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(10)
        if S.AutoDaily then fireRemote("ClaimDaily") fireRemote("DailyReward") end
        if S.AutoQuest then fireRemote("CompleteQuest") fireRemote("ClaimQuest") end
        if S.AutoEvent then fireRemote("ClaimEvent") fireRemote("EventReward") end
    end
end)

task.spawn(function()
    while true do
        task.wait(3)
        if S.AutoCollectReward then
            for _, obj in ipairs(WS:GetDescendants()) do
                local n = obj.Name:lower()
                if n:find("reward") or n:find("chest") or n:find("crate") or n:find("loot") then
                    tryProximity(obj)
                end
            end
        end
    end
end)

-- ─── MOVEMENT ─────────────────────────────────────────

-- Speed / sprint
task.spawn(function()
    while true do
        task.wait(0.1)
        local h = hum()
        if h then
            if S.SpeedEnabled then h.WalkSpeed = S.WalkSpeed
            elseif S.AutoSprint then h.WalkSpeed = S.SprintSpeed
            else h.WalkSpeed = 16 end
        end
    end
end)

-- High jump
task.spawn(function()
    while true do
        task.wait(0.2)
        local h = hum()
        if h and S.HighJump then h.JumpPower = S.JumpPower end
    end
end)

-- Gravity
task.spawn(function()
    while true do
        task.wait(0.5)
        if S.LowGravity then WS.Gravity = S.GravityVal
        else WS.Gravity = 196.2 end
    end
end)

-- Infinite jump
UIS.JumpRequest:Connect(function()
    if S.InfiniteJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Fly
task.spawn(function()
    while true do
        task.wait(0.05)
        if S.FlyEnabled then
            local r = root()
            local h = hum()
            if r and h then
                h.PlatformStand = true
                local move = Vector3.new()
                local cam = WS.CurrentCamera
                if UIS:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.new(0, 1, 0) end
                if move.Magnitude > 0 then r.CFrame = r.CFrame + move.Unit * S.FlySpeed end
            end
        end
    end
end)

-- Noclip
RunService.Stepped:Connect(function()
    if S.NoclipEnabled and LP.Character then
        for _, p in ipairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

-- Anti slip
RunService.Stepped:Connect(function()
    if S.AntiSlip and LP.Character then
        for _, p in ipairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then
                pcall(function()
                    p.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0, 0, 0, 0)
                end)
            end
        end
    end
end)

-- Anti void
task.spawn(function()
    while true do
        task.wait(0.5)
        if S.AntiVoid then
            local r = root()
            if r and r.Position.Y < S.AntiVoidY then
                r.CFrame = CFrame.new(0, 100, 0)
            end
        end
    end
end)

-- ─── ESP ──────────────────────────────────────────────
local espFolder = Instance.new("Folder")
espFolder.Name = "RivoESP"
espFolder.Parent = WS

local function clearESP()
    for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
    for _, v in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if v.Name == "RivoTracer" then v:Destroy() end
    end
end

local function makeLabel(part, text, color)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 40)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = espFolder

    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.4
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1, 0, S.ESPHealth and 0.65 or 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold

    local distStr = ""
    if S.ESPDistance then
        local r = root()
        if r then distStr = "  [" .. math.floor((part.Position - r.Position).Magnitude) .. "m]" end
    end
    lbl.Text = text .. distStr

    if S.ESPHealth then
        local h = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
        if h then
            local bar = Instance.new("Frame", bg)
            bar.Size = UDim2.new(h.Health / h.MaxHealth, 0, 0.3, 0)
            bar.Position = UDim2.new(0, 0, 0.7, 0)
            bar.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
            Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)
        end
    end
end

local function makeTracer(part, color)
    local sg = Instance.new("ScreenGui")
    sg.Name = "RivoTracer"
    sg.ResetOnSpawn = false
    sg.Parent = game:GetService("CoreGui")
    local line = Instance.new("Frame", sg)
    line.BackgroundColor3 = color
    line.BorderSizePixel = 0
    task.spawn(function()
        while S.ESPTracers and part and part.Parent do
            local cam = WS.CurrentCamera
            local vp = cam.ViewportSize
            local oy = S.TracerOrigin == "Center" and vp.Y / 2 or vp.Y
            local origin = Vector2.new(vp.X / 2, oy)
            local pos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen then
                local dx, dy = pos.X - origin.X, pos.Y - origin.Y
                local len = math.sqrt(dx * dx + dy * dy)
                line.Position = UDim2.new(0, origin.X, 0, origin.Y)
                line.Size = UDim2.new(0, len, 0, 1)
                line.Rotation = math.deg(math.atan2(dy, dx))
                line.Visible = true
            else
                line.Visible = false
            end
            task.wait(0.05)
        end
        sg:Destroy()
    end)
end

task.spawn(function()
    while true do
        task.wait(2)
        clearESP()
        if S.ESPEgg then
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n = obj.Name:lower()
                    if n:find("egg") or n:find("ore") or n:find("crystal") then
                        makeLabel(obj, obj.Name, Color3.fromRGB(255, 230, 50))
                    end
                end
            end
        end
        if S.ESPAnimal then
            for _, obj in ipairs(WS:GetDescendants()) do
                if obj:IsA("Model") then
                    local n = obj.Name:lower()
                    if n:find("animal") or n:find("pet") then
                        local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                        if p then
                            makeLabel(p, obj.Name, Color3.fromRGB(50, 255, 160))
                            if S.ESPTracers then makeTracer(p, Color3.fromRGB(50, 255, 160)) end
                        end
                    end
                end
            end
        end
        if S.ESPPlayer then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        makeLabel(hrp, plr.Name, Color3.fromRGB(255, 70, 70))
                        if S.ESPTracers then makeTracer(hrp, Color3.fromRGB(255, 70, 70)) end
                    end
                end
            end
        end
    end
end)

-- ─── MISC LOOPS ───────────────────────────────────────

-- Anti AFK
task.spawn(function()
    while true do
        task.wait(55)
        if S.AntiAFK then
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                task.wait(0.1)
                vim:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            end)
        end
    end
end)

-- Fullbright
task.spawn(function()
    while true do
        task.wait(2)
        pcall(function()
            local L = game:GetService("Lighting")
            if S.Fullbright then
                L.Brightness = 2
                L.ClockTime = 14
                L.FogEnd = 100000
                L.GlobalShadows = false
                L.Ambient = Color3.new(1, 1, 1)
                L.OutdoorAmbient = Color3.new(1, 1, 1)
            end
        end)
    end
end)

-- Chat spam
task.spawn(function()
    while true do
        task.wait(S.ChatDelay)
        if S.ChatSpam then
            pcall(function()
                local req = RS:FindFirstChild("SayMessageRequest", true)
                if req then req:FireServer(S.ChatMsg, "All") end
            end)
        end
    end
end)

-- Server hop
task.spawn(function()
    while true do
        task.wait(30)
        if S.ServerHop and #Players:GetPlayers() <= S.ServerHopMin then
            pcall(function()
                game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
            end)
        end
    end
end)

-- Orbit
task.spawn(function()
    local angle = 0
    while true do
        task.wait(0.05)
        if S.OrbitEnabled and S.TargetPlayer ~= "" then
            local tp = Players:FindFirstChild(S.TargetPlayer)
            if tp and tp.Character then
                local tr = tp.Character:FindFirstChild("HumanoidRootPart")
                local r = root()
                if tr and r then
                    angle = angle + S.OrbitSpeed * 0.05
                    local offset = Vector3.new(math.cos(angle) * S.OrbitRadius, 0, math.sin(angle) * S.OrbitRadius)
                    r.CFrame = CFrame.new(tr.Position + offset, tr.Position)
                end
            end
        end
    end
end)

-- ─── INFO PANEL ───────────────────────────────────────
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastFPSTime >= 1 then
        lastFPS = frameCount
        frameCount = 0
        lastFPSTime = now
    end
end)

task.spawn(function()
    while true do
        task.wait(5)
        pcall(function()
            local stats = game:GetService("Stats")
            pingVal = math.floor(stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
    end
end)

local infoSG = Instance.new("ScreenGui")
infoSG.Name = "RivoInfoPanel"
infoSG.ResetOnSpawn = false
infoSG.Parent = game:GetService("CoreGui")

local infoFrame = Instance.new("Frame", infoSG)
infoFrame.Size = UDim2.new(0, 210, 0, 120)
infoFrame.Position = UDim2.new(1, -220, 0, 10)
infoFrame.BackgroundColor3 = Color3.fromRGB(8, 14, 36)
infoFrame.BackgroundTransparency = 0.3
infoFrame.Visible = false
Instance.new("UICorner", infoFrame).CornerRadius = UDim.new(0, 10)
local iStroke = Instance.new("UIStroke", infoFrame)
iStroke.Color = Color3.fromRGB(60, 130, 255)
iStroke.Thickness = 1.5

local iLabels = {}
for i, k in ipairs({ "FPS", "Ping", "Cash", "Clock", "Players" }) do
    local l = Instance.new("TextLabel", infoFrame)
    l.Size = UDim2.new(1, -10, 0, 20)
    l.Position = UDim2.new(0, 5, 0, 4 + (i - 1) * 22)
    l.BackgroundTransparency = 1
    l.TextColor3 = Color3.fromRGB(180, 210, 255)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = k .. ": —"
    iLabels[k] = l
end

task.spawn(function()
    while true do
        task.wait(0.5)
        infoFrame.Visible = S.InfoPanel
        if S.InfoPanel then
            iLabels["FPS"].Text  = "FPS: "     .. (S.ShowFPS   and lastFPS          or "—")
            iLabels["Ping"].Text = "Ping: "    .. (S.ShowPing  and pingVal .. "ms"  or "—")
            iLabels["Cash"].Text = "Cash: "    .. (S.ShowCash  and cash()           or "—")
            iLabels["Clock"].Text= "Clock: "   .. (S.ShowClock and os.date("%H:%M:%S") or "—")
            iLabels["Players"].Text = "Players: " .. #Players:GetPlayers()
        end
    end
end)

-- ─── HOTKEYS ──────────────────────────────────────────
UIS.JumpRequest:Connect(function()
    if S.InfiniteJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F2 then
        S.Paused = not S.Paused
        WindUI:Notify({ Title = "Rivo Hub", Content = "Paused: " .. tostring(S.Paused), Duration = 2 })
    end
    if input.KeyCode == Enum.KeyCode.F3 then
        S.FlyEnabled = not S.FlyEnabled
        local h = hum()
        if h and not S.FlyEnabled then h.PlatformStand = false end
    end
    if input.KeyCode == Enum.KeyCode.F4 then
        S.NoclipEnabled = not S.NoclipEnabled
    end
end)

